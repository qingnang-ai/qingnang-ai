# Flask 密钥（必填，随机字符串）
FLASK_SECRET_KEY=your-random-secret-key

# DeepSeek API（必填，用于AI报告和客服功能）
DEEPSEEK_API_KEY=your-deepseek-api-key

# 管理员账号（必填）
ADMIN_NAME=青囊馆主
ADMIN_PASSWORD=your-admin-password

# YOLO 模型路径（可选，默认 ~/yolo/best.pt）
# YOLO_MODEL_PATH=/path/to/best.pt

# 支付宝配置（可选，不填则养生坊显示测试模式）
# ALIPAY_APP_ID=your-app-id
# ALIPAY_APP_PRIVATE_KEY=your-private-key
# ALIPAY_ALIPAY_PUBLIC_KEY=your-public-key
